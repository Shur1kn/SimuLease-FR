generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Application {
  id            String   @id @default(cuid())
  name          String
  logo          String?
  summary       String
  descriptionBut    String
  descriptionHow    String
  screenshots   String   @default("[]")
  url           String
  marketCH      Boolean  @default(false)
  marketFR      Boolean  @default(false)
  category      String
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteContent {
  id        String @id @default("main")
  heroTitle     String @default("Développeur de solutions SaaS")
  heroSubtitle  String @default("Pour la Suisse et la France")
  aboutText     String @default("")
  contactEmail  String @default("")
  contactPhone  String @default("")
  contactAddress String @default("")
  linkedinUrl   String @default("")
  updatedAt     DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminUser {
  id        String @id @default(cuid())
  username  String @unique
  password  String
  createdAt DateTime @default(now())
}
